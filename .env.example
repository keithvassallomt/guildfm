# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI: DJ scripts, song picks, text-to-speech and web search.
OPENAI_API_KEY=
# The text-to-speech model, if not gpt-4o-mini-tts.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# The model that picks songs and writes the DJ's lines, and its reasoning effort.
# OPENAI_MODEL=gpt-6-astra
# OPENAI_EFFORT=low
# The image model that paints stations' covers, and its quality (low, medium or high).
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=medium

# ElevenLabs (optional): the account's own voices, offered alongside OpenAI's for the DJ and
# announcements. They understand tags such as [laughs]. Without a key, only OpenAI's voices.
ELEVENLABS_API_KEY=
# The model, if not eleven_v4. eleven_v4_turbo costs half the credits and also takes tags.
# ELEVENLABS_MODEL=eleven_v4

# Spotify developer app (developer.spotify.com). The account that owns the app needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI registered in the Spotify app exactly. Spotify rejects "localhost", so use 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# Signs login sessions. Generate one with: openssl rand -hex 32
GUILDFM_SECRET_KEY=

# The admin account created on first start.
GUILDFM_ADMIN_USERNAME=admin
GUILDFM_ADMIN_PASSWORD=
